function addAttentionCheck(form, name, instruction) {
  // 注意力檢查題，需在原程式碼中找到 AC1/AC2/AC3 的「正確選項」字串：
  var mc = form.addMultipleChoiceItem();
  mc.setTitle(name + '：' + instruction)
    .setRequired(true)
    .setChoiceValues(['A. A', 'B. B', 'C. C', 'D. D']);
  return mc;
}